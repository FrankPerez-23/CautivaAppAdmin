<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Encabezado con Título y Botón Cerrar "X" -->
        <RelativeLayout
            android:id="@+id/encabezado_registro_vehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/texto_titulo_registro_vehiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/boton_cerrar_registro_vehiculo"
                android:text="@string/titulo_registro_vehiculo"
                android:textColor="@color/negro_cautiva"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/boton_cerrar_registro_vehiculo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar formulario"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/negro_cautiva" />

        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/tarjeta_formulario_vehiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/blanco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/encabezado_registro_vehiculo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Campo Placa -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/etiqueta_placa"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:placeholderText="@string/pista_placa"
                    app:startIconDrawable="@drawable/ic_camion"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_placa_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Marca (Ingreso Libre) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_marca"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_marca_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Modelo -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_modelo"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_modelo_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Año -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_anio"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_anio_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Capacidad m3 -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_capacidad_m3"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_capacidad_m3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Estado Operativo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/etiqueta_estado"
                    android:textColor="@color/negro_cautiva"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/grupo_estado_vehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio_activo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="ACTIVO"
                        android:textColor="@color/estado_activo" />

                    <RadioButton
                        android:id="@+id/radio_mantenimiento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MANT."
                        android:textColor="@color/estado_mantenimiento" />

                    <RadioButton
                        android:id="@+id/radio_inactivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="INACTIVO"
                        android:textColor="@color/estado_inactivo" />
                </RadioGroup>

                <!-- Botones Guardar y Cancelar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton_cancelar_registro_vehiculo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:text="Cancelar"
                        android:textAllCaps="false"
                        android:textColor="@color/gris_eslogan"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/gris_claro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton_guardar_vehiculo"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1.5"
                        android:backgroundTint="@color/naranja_cautiva"
                        android:text="@string/boton_guardar_vehiculo"
                        android:textAllCaps="false"
                        android:textColor="@color/blanco"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/barra_progreso_vehiculo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/naranja_cautiva"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>