<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/texto_titulo_registro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/titulo_registro_trabajador"
            android:textColor="@color/negro_cautiva"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/tarjeta_formulario_registro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/blanco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_titulo_registro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nombre -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/etiqueta_nombre"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:startIconDrawable="@drawable/ic_usuario"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_nombre_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Apellido -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_apellido"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:startIconDrawable="@drawable/ic_usuario"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_apellido_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Correo Corporativo -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_correo"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:startIconDrawable="@drawable/ic_correo"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_correo_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teléfono -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_telefono"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:startIconDrawable="@drawable/ic_telefono"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_telefono_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña Provisional con Ojito -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/etiqueta_clave_provisional"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:endIconTint="@color/gris_eslogan"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:passwordToggleEnabled="true"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_clave_provisional_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón Registrar Chofer (#F27824) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_registrar_conductor"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/naranja_cautiva"
                    android:text="@string/boton_registrar"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <!-- Indicador de Progreso -->
                <ProgressBar
                    android:id="@+id/barra_progreso_registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/naranja_cautiva"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>