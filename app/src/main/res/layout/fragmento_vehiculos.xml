<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:padding="16dp">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/texto_titulo_vehiculos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_pestana_gestion_vehiculos"
        android:textColor="@color/negro_cautiva"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Campo de Búsqueda -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/contenedor_busqueda_vehiculos"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Buscar por placa o marca"
        app:startIconDrawable="@drawable/ic_buscar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_titulo_vehiculos">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campo_busqueda_vehiculos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/barra_cargando_vehiculos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/naranja_cautiva"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_busqueda_vehiculos" />

    <!-- Texto Lista Vacía -->
    <TextView
        android:id="@+id/texto_lista_vacia_vehiculos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se encontraron vehículos registrados"
        android:textColor="@color/gris_eslogan"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_busqueda_vehiculos" />

    <!-- RecyclerView de Vehículos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_vehiculos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_busqueda_vehiculos"
        tools:listitem="@layout/item_vehiculo" />

    <!-- Botón Flotante para Agregar Vehículo -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/boton_agregar_vehiculo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Agregar nuevo vehículo"
        android:src="@drawable/ic_mas"
        app:backgroundTint="@color/naranja_cautiva"
        app:tint="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor Hijo para el Formulario de Registro de Vehículos (Child Fragment Overlay) -->
    <FrameLayout
        android:id="@+id/contenedor_registro_vehiculo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fondo_app"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>