<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/blanco">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Datos del Chofer"
        android:textColor="@color/negro_cautiva"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/EstiloEntradaTextoCautiva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/etiqueta_nombre"
        android:textColorHint="@color/gris_eslogan"
        app:boxBackgroundColor="@color/blanco"
        app:boxStrokeColor="@color/selector_borde_campo_texto"
        app:hintTextColor="@color/naranja_cautiva">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campo_editar_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textColor="@color/negro_cautiva"
            android:textColorHint="@color/gris_eslogan" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/EstiloEntradaTextoCautiva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/etiqueta_apellido"
        android:textColorHint="@color/gris_eslogan"
        app:boxBackgroundColor="@color/blanco"
        app:boxStrokeColor="@color/selector_borde_campo_texto"
        app:hintTextColor="@color/naranja_cautiva">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campo_editar_apellido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textColor="@color/negro_cautiva"
            android:textColorHint="@color/gris_eslogan" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/EstiloEntradaTextoCautiva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/etiqueta_telefono"
        android:textColorHint="@color/gris_eslogan"
        app:boxBackgroundColor="@color/blanco"
        app:boxStrokeColor="@color/selector_borde_campo_texto"
        app:hintTextColor="@color/naranja_cautiva">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campo_editar_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/negro_cautiva"
            android:textColorHint="@color/gris_eslogan" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/etiqueta_vehiculo_asignado"
        android:textColor="@color/negro_cautiva"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/selector_editar_vehiculo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/fondo_campo_texto"
        android:paddingHorizontal="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_cancelar_edicion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@color/gris_eslogan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_guardar_edicion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/naranja_cautiva"
            android:text="Guardar Cambios"
            android:textColor="@color/blanco" />
    </LinearLayout>

</LinearLayout>