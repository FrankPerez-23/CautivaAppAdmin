<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- Logo Cautiva Centrado -->
        <ImageView
            android:id="@+id/imagen_logo_cautiva"
            android:layout_width="220dp"
            android:layout_height="100dp"
            android:layout_marginTop="40dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_cautiva"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtítulo de Panel Admin -->
        <TextView
            android:id="@+id/texto_subtitulo_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/subtitulo_login"
            android:textColor="@color/gris_eslogan"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagen_logo_cautiva" />

        <!-- Tarjeta del Formulario -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tarjeta_formulario_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/blanco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_subtitulo_login">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciar Sesión"
                    android:textColor="@color/negro_cautiva"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Campo Correo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contenedor_campo_correo"
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/etiqueta_correo"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:placeholderText="@string/pista_correo"
                    app:startIconDrawable="@drawable/ic_correo"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_correo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contenedor_campo_contrasena"
                    style="@style/EstiloEntradaTextoCautiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/etiqueta_contrasena"
                    android:textColorHint="@color/gris_eslogan"
                    app:boxBackgroundColor="@color/blanco"
                    app:boxStrokeColor="@color/selector_borde_campo_texto"
                    app:endIconTint="@color/gris_eslogan"
                    app:hintTextColor="@color/naranja_cautiva"
                    app:passwordToggleEnabled="true"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:startIconTint="@color/gris_eslogan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/negro_cautiva"
                        android:textColorHint="@color/gris_eslogan" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mensaje de Error -->
                <TextView
                    android:id="@+id/texto_error_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/rojo_cautiva"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Error al ingresar"
                    tools:visibility="visible" />

                <!-- Botón Ingresar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_iniciar_sesion"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/amarillo_cautiva"
                    android:text="@string/boton_iniciar_sesion"
                    android:textColor="@color/negro_cautiva"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <!-- Barra de Cargando -->
                <ProgressBar
                    android:id="@+id/barra_progreso_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/naranja_cautiva"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>