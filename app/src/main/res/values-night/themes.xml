<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema fijo para garantizar la misma paleta e inputs sin importar el modo del sistema -->
    <style name="Base.Theme.CautivaAppAdmin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/amarillo_cautiva</item>
        <item name="colorOnPrimary">@color/negro_cautiva</item>
        <item name="colorSecondary">@color/naranja_cautiva</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:statusBarColor">@color/negro_cautiva</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/fondo_app</item>

        <!-- Colores fijos permanentes para campos de texto -->
        <item name="android:editTextColor">@color/negro_cautiva</item>
        <item name="android:textColor">@color/negro_cautiva</item>
        <item name="android:textColorHint">@color/gris_eslogan</item>
        <item name="editTextStyle">@style/EstiloCampoEdicionCautiva</item>
        <item name="textInputStyle">@style/EstiloEntradaTextoCautiva</item>
    </style>

    <style name="Theme.CautivaAppAdmin" parent="Base.Theme.CautivaAppAdmin" />

    <style name="EstiloEntradaTextoCautiva" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/selector_borde_campo_texto</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:textColorHint">@color/gris_eslogan</item>
        <item name="hintTextColor">@color/naranja_cautiva</item>
        <item name="startIconTint">@color/gris_eslogan</item>
        <item name="endIconTint">@color/gris_eslogan</item>
    </style>

    <style name="EstiloCampoEdicionCautiva" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/negro_cautiva</item>
        <item name="android:textColorHint">@color/gris_eslogan</item>
    </style>
</resources>